          <type>std::optional&lt; <ref refid="classsf_1_1IpAddress_1ad229bc2e10d361457e5c8eaf6e9304ba" kindref="member">IpAddress::Type</ref> &gt;</type>
          <declname>addressType</declname>
          <defval>std::nullopt</defval>
