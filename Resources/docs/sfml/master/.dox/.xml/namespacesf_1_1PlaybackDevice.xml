        <definition>SFML_AUDIO_API bool sf::PlaybackDevice::setDevice</definition>
        <argsstring>(const std::string &amp;name)</argsstring>
        <name>setDevice</name>
        <qualifiedname>sf::PlaybackDevice::setDevice</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>name</declname>
        </param>
        <briefdescription>
<para>Set the audio playback device. </para>
        </briefdescription>
        <detaileddescription>
<para>This function sets the audio playback device to the device with the given <computeroutput>name</computeroutput>. It can be called on the fly (i.e: while sounds are playing).</para>
<para>If there are sounds playing when the audio playback device is switched, the sounds will continue playing uninterrupted on the new audio playback device.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>name</parametername>
</parameternamelist>
<parameterdescription>
<para>The name of the audio playback device</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><computeroutput>true</computeroutput>, if it was able to set the requested device</para>
</simplesect>
<simplesect kind="see"><para><computeroutput><ref refid="namespacesf_1_1PlaybackDevice_1a51f1a1e2fdcb8bf1f66c2f382c481136" kindref="member">getAvailableDevices</ref></computeroutput>, <computeroutput><ref refid="namespacesf_1_1PlaybackDevice_1ac694a0167e72059796906c00b060db9a" kindref="member">getDefaultDevice</ref></computeroutput>, <computeroutput><ref refid="namespacesf_1_1PlaybackDevice_1a40b2ba298dd33c75f007888e11b3763c" kindref="member">setDeviceToDefault</ref></computeroutput>, <computeroutput><ref refid="namespacesf_1_1PlaybackDevice_1a0cc7d23c09cbdc7db98c4bcec356da80" kindref="member">setDeviceToNull</ref></computeroutput> </para>
</simplesect>
</para>
        </detaileddescription>
