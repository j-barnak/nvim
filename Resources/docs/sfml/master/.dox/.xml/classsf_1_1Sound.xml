        <reimplements refid="classsf_1_1SoundSource_1a6e1bbb1f247ed8743faf3b1ed6f2bc21">play</reimplements>
        <briefdescription>
<para>Start or resume playing the sound. </para>
        </briefdescription>
        <detaileddescription>
<para>This function starts the stream if it was stopped, resumes it if it was paused, and restarts it from beginning if it was it already playing. This function uses its own thread so that it doesn&apos;t block the rest of the program while the sound is played.</para>
<para><simplesect kind="see"><para><computeroutput><ref refid="classsf_1_1Sound_1a24b31c90af33c6bdc302f876abdf8a39" kindref="member">pause</ref></computeroutput>, <computeroutput><ref refid="classsf_1_1Sound_1a90c9112782d5bc424a8e9e3ee7ecef19" kindref="member">stop</ref></computeroutput> </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/home/jared/.local/share/nvim/docs/sfml/master/include/SFML/Audio/Sound.hpp" line="90" column="10"/>
